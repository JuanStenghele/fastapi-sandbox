{
	"name": "FastAPI Sandbox Dev Container",
	"image": "mcr.microsoft.com/devcontainers/python:3.13",
	// Change container's name
	"runArgs": ["--name", "dev-fastapi-sandbox"],
	"postCreateCommand": "pip install -r requirements.txt -r test/requirements.txt",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/terraform:1": {},
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"kubernetesVersion": "1.35"
		},
		"ghcr.io/devcontainers-extra/features/opencode:1": {}
	},
	"customizations": {
		"vscode": {
			// Add extensions
			"extensions": [
				"ms-python.python",
				"4ops.terraform",
				"ms-kubernetes-tools.vscode-kubernetes-tools"
			]
		}
	}
}