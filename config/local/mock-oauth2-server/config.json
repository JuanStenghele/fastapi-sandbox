{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "fastapi-sandbox",
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "admin",
          "claims": {
            "sub": "${subject}",
            "aud": ["fastapi-sandbox"],
            "permissions": ["admin"]
          }
        },
        {
          "requestParam": "subject",
          "match": ".*",
          "claims": {
            "sub": "${subject}",
            "aud": ["fastapi-sandbox"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "admin",
          "claims": {
            "sub": "${clientId}",
            "aud": ["fastapi-sandbox"],
            "permissions": ["admin"]
          }
        },
        {
          "requestParam": "client_id",
          "match": ".*",
          "claims": {
            "sub": "${clientId}",
            "aud": ["fastapi-sandbox"]
          }
        }
      ]
    }
  ]
}
